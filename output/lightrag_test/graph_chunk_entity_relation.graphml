    <node id="卡芙卡">
      <data key="d0">卡芙卡</data>
      <data key="d1">person</data>
      <data key="d2">卡芙卡is a person involved in a conversation about the mysterious individual and Black Tower.&lt;SEP&gt;卡芙卡is a member of the Star Hunters who arrives at the space station and takes over the operation.&lt;SEP&gt;卡芙卡is a character who comments on the weakness of the anti-matter legion and identifies various geniuses.</data>
      <data key="d3">chunk-c62549d358805658f577edf0ab9b10f6&lt;SEP&gt;chunk-c7d8a992974bc2f1f0901e4cbb9b3e71&lt;SEP&gt;chunk-a3cfc8f55ca58a8b49ae984321424c78</data>
