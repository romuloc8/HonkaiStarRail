    </node>
    <node id="能源管线">
      <data key="d0">能源管线</data>
      <data key="d1">concept</data>
      <data key="d2">The能源管线is the power line that希露瓦claims is faulty, serving as the pretext for entering the restricted area.</data>
      <data key="d3">chunk-fd6c21ae8658032a7c6a70abba655057</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778757801</data>
