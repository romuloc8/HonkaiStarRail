    <node id="明阅">
      <data key="d0">明阅</data>
      <data key="d1">person</data>
      <data key="d2">明阅is a person at the Divination Commission who recognizes Qingque as a rarity seen during work hours and comments on the unusual nature of the visitors.</data>
      <data key="d3">chunk-2b7f59f879256f855b57fd2b90f2f093</data>
