      <data key="d0">「领航员」格兰霍姆</data>
      <data key="d1">person</data>
      <data key="d2">「领航员」格兰霍姆是星穹列车的历任领航员之一，与拉格沃克告别时赠送了阿蒙森的帽子。</data>
      <data key="d3">chunk-8a4bb44dd906f564ea60408699af064c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779069790</data>
      <data key="d6" />
    </node>
    <node id="来日的声音">
      <data key="d0">来日的声音</data>
      <data key="d1">concept</data>
      <data key="d2">来日的声音represents voices from the future that speak of a king being sent off and declare that they no longer need a king.&lt;SEP&gt;来日的声音declares that 'they,' presumably the collective, are the supreme kings beyond all things.</data>
      <data key="d3">chunk-9d8d43bcd5da9f1a53fc3bdb43750929</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779069798</data>
      <data key="d6" />
    </node>
    <node id="露莎卡">
      <data key="d0">露莎卡</data>
      <data key="d1">location</data>
      <data key="d2">露莎卡是「航海士」米哈伊尔计划前往营救的地点。</data>
      <data key="d3">chunk-8a4bb44dd906f564ea60408699af064c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779069799</data>
