    <edge source="星期日" target="神">
      <data key="d7">1.0</data>
      <data key="d8">星期日代表神向梦主提问，并传达神的认可。</data>
      <data key="d9">代表,沟通</data>
      <data key="d10">chunk-54eac7c3e839691c079d25a3b921a4d7</data>
