    <node id="舒翁">
      <data key="d0">舒翁</data>
      <data key="d1">person</data>
      <data key="d2">the owner of the bar who is known to be a skilled individual.&lt;SEP&gt;舒翁is the bartender and host of the惊梦酒吧, known for her welcoming attitude and witty remarks.&lt;SEP&gt;舒翁is a character who offers the syrup to三月七and the group, explaining it is safe to consume in a dream.&lt;SEP&gt;舒翁(舒翁女士)是酒吧的经营者，她认为艾米绮的梦想不切实际，并代付了饮料钱。她建议主角准备好后去找加拉赫。&lt;SEP&gt;舒翁是一位称赞加拉赫调制技术高超的人物，认为他宝刀未老。&lt;SEP&gt;舒翁is a bartender or owner of the "惊梦酒吧" who rejects a proposition from艾米绮.</data>
      <data key="d3">chunk-ff27003d40cef9e5eea6b05a7803810c&lt;SEP&gt;chunk-622a56b244419f3133bcd4b11feb44f0&lt;SEP&gt;chunk-d3e02a2272395c7c81c9cd1263f09605&lt;SEP&gt;chunk-bb2a372ee2f9460e30f608f49c4ae874&lt;SEP&gt;chunk-3428cb608b39b27cf65390b499a0173e&lt;SEP&gt;chunk-bafb0a0e0f90ec9d367776c00f11b4a7</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779005938</data>
      <data key="d6" />
    </node>
    <node id="饮料">
      <data key="d0">饮料</data>
      <data key="d1">concept</data>
      <data key="d2">a general term for drinks, including soda and beverages.</data>
      <data key="d3">chunk-ff27003d40cef9e5eea6b05a7803810c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778900767</data>
      <data key="d6" />
    </node>
    <node id="调饮师">
      <data key="d0">调饮师</data>
      <data key="d1">person</data>
      <data key="d2">A bartender or mixologist who prides themselves on serving unique drinks, such as the one at the bar.</data>
