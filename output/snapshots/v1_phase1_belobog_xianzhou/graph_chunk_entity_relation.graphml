    <node id="凯文">
      <data key="d0">凯文</data>
      <data key="d1">person</data>
      <data key="d2">凯文is a man mentioned in瓦尔特's story. When facing an incurable wound in the world, he decided to weave everyone's dreams together and bear the burden of creating the "精神的亚当".</data>
      <data key="d3">chunk-ee77b88c86c938c0967cd2eb1ef92ec0</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779005940</data>
