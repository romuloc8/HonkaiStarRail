    <node id="不良资产清算专家">
      <data key="d0">不良资产清算专家</data>
      <data key="d1">concept</data>
      <data key="d2">不良资产清算专家is Aventurine's job title, meaning an expert in liquidating bad assets.</data>
      <data key="d3">chunk-70d2b43f7c6354bc0d0b43505f6ba515</data>
