    <node id="供暖">
      <data key="d0">供暖</data>
      <data key="d1">concept</data>
      <data key="d2">供暖is the heating system that希露瓦mentions might fail, threatening to freeze people if not fixed.</data>
      <data key="d3">chunk-fd6c21ae8658032a7c6a70abba655057</data>
