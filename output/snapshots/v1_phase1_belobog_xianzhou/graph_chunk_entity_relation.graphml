    <node id="派系">
      <data key="d0">派系</data>
      <data key="d1">concept</data>
      <data key="d2">派系are groups or organizations within the universe that are closely related to people and often have interstellar jump capabilities.</data>
      <data key="d3">chunk-010cf81a86ef8e6d81978812db1537ce</data>
