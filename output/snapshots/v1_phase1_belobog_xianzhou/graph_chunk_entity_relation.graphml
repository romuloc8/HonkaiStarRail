    <node id="Creation Furnace">
      <data key="d0">Creation Furnace</data>
      <data key="d1">location</data>
      <data key="d2">The "Creation Furnace" is a location on the Xianzhou Luofu, currently entangled by withered roots from the Ambrosial Arbor.</data>
