      <data key="d3">chunk-b5611e840a75b01108d00f49d206e97a&lt;SEP&gt;chunk-8cbbecf39bafc8dba9cd07bec4cf605e</data>
      <data key="d2">桑博需要街机通关的奖励来让体验者感受「有趣的东西」。&lt;SEP&gt;街机is an arcade machine located near the salon that桑博intends to use.</data>
      <data key="d1">artifact</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836440</data>
      <data key="d6" />
    </node>
    <node id="莎塔娜">
      <data key="d0">莎塔娜</data>
      <data key="d1">person</data>
      <data key="d2">莎塔娜is a character who proposes a contract to开拓者, speaking of a false king and the need to unite the trash cans.&lt;SEP&gt;A character who inquires if the protagonist has heard of the "Trash King" Tatalov and experiences a sense of deja vu.&lt;SEP&gt;Shatana is a character who acknowledges the Trailblazer's completion of the contract and offers to escort them to the throne "Pillar of Creation" to witness the future of their people.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e&lt;SEP&gt;chunk-28e43423b829e0e1a4b962a14f6ade99&lt;SEP&gt;chunk-1ca69e71f2592c01816410bbfe101c20</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836917</data>
      <data key="d6" />
    </node>
    <node id="祂(The False King)">
      <data key="d0">祂(The False King)</data>
      <data key="d1">person</data>
      <data key="d2">祂is the false king, referred to as the shepherd of all waste, whose eyes were blinded by the arrival of the celestial object and the cold wave, leading to the oppression of the humble buckets.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836357</data>
      <data key="d6" />
    </node>
    <node id="天外之物(Celestial Object)">
      <data key="d0">天外之物(Celestial Object)</data>
      <data key="d1">concept</data>
      <data key="d2">The天外之物is the celestial object that descended with the cold wave, leading to the blinding of the false king.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836360</data>
      <data key="d6" />
    </node>
    <node id="寒潮(Cold Wave)">
      <data key="d0">寒潮(Cold Wave)</data>
      <data key="d1">event</data>
      <data key="d2">寒潮is a cold wave that arrived alongside the celestial object and blinded the false king.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836360</data>
      <data key="d6" />
    </node>
    <node id="天火地火(Heavenly Fire Earth Fire)">
      <data key="d0">天火地火(Heavenly Fire Earth Fire)</data>
      <data key="d1">concept</data>
      <data key="d2">天火地火is the banner under which莎塔娜and the rebellious buckets fight against the evil false king.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836360</data>
      <data key="d6" />
    </node>
    <node id="垃圾之王(King of Trash)">
      <data key="d0">垃圾之王(King of Trash)</data>
      <data key="d1">person</data>
      <data key="d2">垃圾之王is another name for the false king, the ruler of the trash cans who has gone astray.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836363</data>
      <data key="d6" />
    </node>
    <node id="众桶(The Buckets)">
      <data key="d0">众桶(The Buckets)</data>
      <data key="d1">concept</data>
      <data key="d2">众桶refers to the collective of trash cans that have been unlinked due to the king's slander.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836363</data>
      <data key="d6" />
    </node>
    <node id="垃圾袋(Trash Bag)">
      <data key="d0">垃圾袋(Trash Bag)</data>
      <data key="d1">concept</data>
      <data key="d2">垃圾袋is another term for the heart or conscience of the buckets, which are no longer able to sense each other.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836364</data>
      <data key="d6" />
    </node>
    <node id="信任的证明(Proofs of Trust)">
      <data key="d0">信任的证明(Proofs of Trust)</data>
      <data key="d1">concept</data>
      <data key="d2">信任的证明are three items that开拓者must help the trash cans attain to relieve their troubles.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836365</data>
      <data key="d6" />
    </node>
    <node id="新王(New King)">
      <data key="d0">新王(New King)</data>
      <data key="d1">person</data>
      <data key="d2">新王is the role开拓者could become after completing the task, leading the rebellion against the false king.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836366</data>
      <data key="d6" />
    </node>
    <node id="伪王(False King)">
      <data key="d0">伪王(False King)</data>
      <data key="d1">person</data>
      <data key="d2">伪王is the false king that莎塔娜and others are fighting against.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836366</data>
      <data key="d6" />
    </node>
    <node id="契约(Contract)">
      <data key="d0">契约(Contract)</data>
      <data key="d1">concept</data>
      <data key="d2">契约is the agreement莎塔娜proposes to开拓者, which involves helping the trash cans and obtaining three proofs of trust.</data>
      <data key="d3">chunk-ef6981d8589b8138e2d6716a404ea00e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778836367</data>
