    <node id="罗浮云骑">
      <data key="d0">罗浮云骑</data>
      <data key="d1">organization</data>
      <data key="d2">罗浮云骑是仙舟罗浮的军事力量，丹恒希望通过结盟玉兆获得其支援。</data>
