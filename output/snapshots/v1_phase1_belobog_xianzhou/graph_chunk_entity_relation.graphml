      <data key="d3">chunk-9189bbff0cdab4202d189f24260b142b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100458</data>
      <data key="d6" />
    </node>
    <node id="让囚徒学会自由">
      <data key="d0">让囚徒学会自由</data>
      <data key="d1">concept</data>
      <data key="d2">让囚徒学会自由是往昔的声音对囚徒的命令，要求他们教会自己兄弟。</data>
      <data key="d3">chunk-9189bbff0cdab4202d189f24260b142b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100461</data>
      <data key="d6" />
    </node>
    <node id="幕前剧">
      <data key="d0">幕前剧</data>
      <data key="d1">event</data>
      <data key="d2">The pre-shows are three performances that星期日invites the characters to observe before the grand ceremony.</data>
      <data key="d3">chunk-adc094529bd44146c762587e8b448ea2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100465</data>
      <data key="d6" />
    </node>
    <node id="盛典">
      <data key="d0">盛典</data>
      <data key="d1">event</data>
      <data key="d2">The grand ceremony is the event that is set to begin, for which the pre-shows are a precursor.</data>
      <data key="d3">chunk-adc094529bd44146c762587e8b448ea2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100465</data>
      <data key="d6" />
    </node>
    <node id="第一幕">
      <data key="d0">第一幕</data>
      <data key="d3">chunk-9189bbff0cdab4202d189f24260b142b</data>
      <data key="d2">星期日总结第一幕剧情为边陲监狱走向流放之地。</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100484</data>
      <data key="d6" />
    </node>
    <node id="焦土">
      <data key="d0">焦土</data>
      <data key="d3">chunk-9189bbff0cdab4202d189f24260b142b</data>
      <data key="d2">边陲战争后，囚犯们在焦土之上建立了自由之地。</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100490</data>
      <data key="d6" />
    </node>
    <node id="内部战火">
      <data key="d0">内部战火</data>
      <data key="d3">chunk-9189bbff0cdab4202d189f24260b142b</data>
      <data key="d2">阿斯德纳再度被来自内部的战火席卷。</data>
      <data key="d1">UNKNOWN</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100495</data>
      <data key="d6" />
    </node>
    <node id="观众">
      <data key="d0">观众</data>
      <data key="d1">person</data>
      <data key="d2">观众refers to the audience who have not yet entered the theater.</data>
      <data key="d3">chunk-cbb8a3bfa4ae13183c3d097c522f56f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100513</data>
      <data key="d6" />
    </node>
    <node id="场务">
      <data key="d0">场务</data>
      <data key="d1">person</data>
      <data key="d2">场务are stage staff who are absent from the theater.</data>
      <data key="d3">chunk-cbb8a3bfa4ae13183c3d097c522f56f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100514</data>
      <data key="d6" />
    </node>
    <node id="售票处">
      <data key="d0">售票处</data>
      <data key="d1">location</data>
      <data key="d2">售票处is the ticket booth in the theater where many puppets are found.</data>
      <data key="d3">chunk-cbb8a3bfa4ae13183c3d097c522f56f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100517</data>
      <data key="d6" />
    </node>
    <node id="前厅">
      <data key="d0">前厅</data>
      <data key="d1">location</data>
      <data key="d2">前厅is the lobby of the theater, which is completely empty of people.</data>
      <data key="d3">chunk-cbb8a3bfa4ae13183c3d097c522f56f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100518</data>
      <data key="d6" />
    </node>
    <node id="舞台上的布景">
      <data key="d0">舞台上的布景</data>
      <data key="d1">concept</data>
      <data key="d2">舞台上的布景are theatrical scenery props used on stage, which姬子speculates the puppets might be.</data>
      <data key="d3">chunk-cbb8a3bfa4ae13183c3d097c522f56f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100520</data>
      <data key="d6" />
    </node>
    <node id="异常">
      <data key="d0">异常</data>
      <data key="d1">concept</data>
      <data key="d2">异常refers to the abnormal situation where the theater's lobby is completely empty of people.</data>
      <data key="d3">chunk-cbb8a3bfa4ae13183c3d097c522f56f8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100521</data>
      <data key="d6" />
    </node>
    <node id="会计">
      <data key="d0">会计</data>
      <data key="d1">person</data>
      <data key="d2">会计是在寓言故事中出现的角色，自称被烈火造化，比商人更高贵。&lt;SEP&gt;会计是一个忠诚守望主人归来、期待嘉奖的仆人角色，在主人不在后转向自行索取。</data>
      <data key="d3">chunk-f25c87c66c524f1eaa36bafc4c949cbc&lt;SEP&gt;chunk-900f45b839e44f78ea4e418b6d10c897</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100619</data>
      <data key="d6" />
    </node>
    <node id="养蜂人">
      <data key="d0">养蜂人</data>
      <data key="d1">person</data>
      <data key="d2">养蜂人是在寓言故事中出现的角色，知晓自己会为蜂毒所害的命运。</data>
      <data key="d3">chunk-f25c87c66c524f1eaa36bafc4c949cbc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100537</data>
      <data key="d6" />
    </node>
    <node id="新至的主人">
      <data key="d0">新至的主人</data>
      <data key="d1">person</data>
      <data key="d2">新至的主人是在寓言故事中出现的角色，声称要成为诸位新的家人并将他们从幻影中解放。&lt;SEP&gt;新至的主人是一位外来宾客，引导仆人们取回理性，并号召他们互助互勉、战胜虚幻。</data>
      <data key="d3">chunk-f25c87c66c524f1eaa36bafc4c949cbc&lt;SEP&gt;chunk-900f45b839e44f78ea4e418b6d10c897</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100623</data>
      <data key="d6" />
    </node>
    <node id="白色沙漠事件">
      <data key="d0">白色沙漠事件</data>
      <data key="d1">event</data>
      <data key="d2">白色沙漠事件是由苜蓿草家系策划的事件，导致黑布林家系覆灭。</data>
      <data key="d3">chunk-f25c87c66c524f1eaa36bafc4c949cbc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100541</data>
      <data key="d6" />
    </node>
    <node id="黑布林家系">
      <data key="d0">黑布林家系</data>
      <data key="d1">organization</data>
      <data key="d2">黑布林家系是匹诺康尼的七大家系之一，在“白色沙漠”事件中覆灭。</data>
      <data key="d3">chunk-f25c87c66c524f1eaa36bafc4c949cbc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100544</data>
      <data key="d6" />
    </node>
    <node id="树、草、花、鸟、兽、果、虫七大家系">
      <data key="d0">树、草、花、鸟、兽、果、虫七大家系</data>
      <data key="d1">organization</data>
      <data key="d2">树、草、花、鸟、兽、果、虫七大家系是在匹诺康尼相继形成的家族。</data>
      <data key="d3">chunk-f25c87c66c524f1eaa36bafc4c949cbc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100547</data>
      <data key="d6" />
    </node>
    <node id="帝国">
      <data key="d0">帝国</data>
      <data key="d1">organization</data>
      <data key="d2">帝国是寓言中曾经统治流放之地的势力，被新至的主人视为“死去的幻影”。</data>
      <data key="d3">chunk-f25c87c66c524f1eaa36bafc4c949cbc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100551</data>
      <data key="d6" />
    </node>
    <node id="教唆者">
      <data key="d0">教唆者</data>
      <data key="d1">concept</data>
      <data key="d2">教唆者是寓言中潜藏在宅邸内、对家系进行虚假操控的负面角色，新至的主人请求帮助驱逐。</data>
      <data key="d3">chunk-f25c87c66c524f1eaa36bafc4c949cbc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100552</data>
      <data key="d6" />
    </node>
    <node id="毁灭坑">
      <data key="d0">毁灭坑</data>
      <data key="d1">location</data>
      <data key="d2">毁灭坑is a location where太一was cast down by the people.</data>
      <data key="d3">chunk-a8a929a77ffa0523358ea526d90b536b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100554</data>
      <data key="d6" />
    </node>
    <node id="旧日的主人">
      <data key="d0">旧日的主人</data>
      <data key="d1">concept</data>
      <data key="d2">旧日的主人是寓言中宅邸最初的缔造者，已被下人驱逐，被新至的主人视为死去的幻影。</data>
      <data key="d3">chunk-f25c87c66c524f1eaa36bafc4c949cbc</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100557</data>
      <data key="d6" />
    </node>
    <node id="下仆">
      <data key="d0">下仆</data>
      <data key="d1">person</data>
      <data key="d2">下仆是寓言中驱逐旧日主人、渴望取代主人地位的仆人群体。</data>
