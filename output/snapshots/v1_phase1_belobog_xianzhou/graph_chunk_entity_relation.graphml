    <node id="？？？(旅伴)">
      <data key="d0">？？？(旅伴)</data>
      <data key="d1">person</data>
      <data key="d2">旅伴是一个在死海边出现、为黄泉提供浆果并与之对话的神秘人物，观察敏锐，能感受到黄泉的情绪。</data>
      <data key="d3">chunk-05a52baa9f6e0386aac3ddefb6f99df9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779069952</data>
