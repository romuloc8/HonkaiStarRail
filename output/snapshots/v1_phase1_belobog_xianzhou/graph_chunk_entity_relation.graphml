    <node id="大琴">
      <data key="d0">大琴</data>
      <data key="d1">artifact</data>
      <data key="d2">大琴是一种以黑白键构成的乐器，在星期日描述的乐章中作为乐器使用。</data>
      <data key="d3">chunk-0ff005ff5250bdd968a0607ccea99b8f&lt;SEP&gt;chunk-5855a83e99050d0498aa175b3322d047</data>
      <data key="d4">unknown_source</data>
