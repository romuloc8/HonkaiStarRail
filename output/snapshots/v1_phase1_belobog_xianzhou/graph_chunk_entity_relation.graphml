      <data key="d0">艾米绮的请求</data>
      <data key="d1">concept</data>
      <data key="d2">艾米绮的请求是她希望舒翁答应并跟随她离开怪物酒吧，回到当初的舞台。</data>
      <data key="d3">chunk-bb2a372ee2f9460e30f608f49c4ae874</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779005768</data>
