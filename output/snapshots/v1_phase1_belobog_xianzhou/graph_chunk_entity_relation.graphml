    <node id="黄金年代">
      <data key="d0">黄金年代</data>
      <data key="d1">event</data>
      <data key="d2">黄金年代is a period or event referenced in the story context of Penacony, associated with its golden era.</data>
      <data key="d3">chunk-f538a89763c2867e55afcfe01521fffd</data>
      <data key="d4">unknown_source</data>
