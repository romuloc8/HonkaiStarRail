    </node>
    <node id="铁卫禁区前线">
      <data key="d0">铁卫禁区前线</data>
      <data key="d1">location</data>
      <data key="d2">铁卫禁区的前线是银鬃铁卫驻扎和抵抗裂界的具体区域，前往北部雪原需穿过此处。</data>
      <data key="d3">chunk-a472ad06854cfbea32b100ad930934ad</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778757803</data>
