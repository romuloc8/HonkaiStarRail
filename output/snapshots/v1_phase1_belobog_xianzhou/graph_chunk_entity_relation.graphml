    <node id="音符">
      <data key="d0">音符</data>
      <data key="d1">concept</data>
      <data key="d2">音符是发音和计数的符号，在星期日描述的乐章中作为音符使用。</data>
      <data key="d3">chunk-0ff005ff5250bdd968a0607ccea99b8f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779100601</data>
