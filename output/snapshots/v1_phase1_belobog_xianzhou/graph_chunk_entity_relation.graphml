    <node id="俄尔刻龙">
      <data key="d0">俄尔刻龙</data>
      <data key="d1">location</data>
      <data key="d2">俄尔刻龙是黄泉旅途的上一站，有荒无人烟的山崖和火堆，下紫红色的雪，味道像树莓。</data>
      <data key="d3">chunk-05a52baa9f6e0386aac3ddefb6f99df9</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1779069954</data>
