    <node id="三重眼的地母神">
      <data key="d0">三重眼的地母神</data>
      <data key="d1">concept</data>
      <data key="d2">The Mother Goddess with Three Eyes, also known as Fingo-Bijos, is a folk deity worshipped by the tribes on Tsugania, independent of the Aeon system.</data>
      <data key="d3">chunk-6d7a59509484cbe6f53205988ca34274</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778899657</data>
