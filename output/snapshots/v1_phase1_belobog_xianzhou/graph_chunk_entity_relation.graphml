      <data key="d0">军事重地</data>
      <data key="d1">location</data>
      <data key="d2">The军事重地is the military area guarded by the银鬃铁卫, considered off-limits to civilians.</data>
      <data key="d3">chunk-fd6c21ae8658032a7c6a70abba655057</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778757795</data>
      <data key="d6" />
    </node>
    <node id="临时访客证">
      <data key="d0">临时访客证</data>
      <data key="d1">artefact</data>
      <data key="d2">The临时访客证is a temporary visitor pass issued by弗朗兹to allow希露瓦and her assistants entry.</data>
      <data key="d3">chunk-fd6c21ae8658032a7c6a70abba655057</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1778757798</data>
