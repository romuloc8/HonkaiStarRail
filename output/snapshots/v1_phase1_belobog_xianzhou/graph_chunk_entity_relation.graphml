      <data key="d1">concept</data>
      <data key="d2">变量二是外来者的动机，作为史瓦罗重新评估时考虑的因素。</data>
      <data key="d3">chunk-b8aea3ce7e067d8f4062dc3a1d66bc67</data>
      <data key="d4">unknown_source</data>
