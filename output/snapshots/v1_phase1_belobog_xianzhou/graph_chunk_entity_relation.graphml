      <data key="d13" />
    </edge>
    <edge source="星穹列车" target="开拓信条">
      <data key="d7">1.0</data>
      <data key="d8">星穹列车的开拓信条是“探索、了解、建立、连结”。</data>
      <data key="d9">信奉,宗旨</data>
