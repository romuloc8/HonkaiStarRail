    </node>
    <node id="公司员工">
      <data key="d0">公司员工</data>
      <data key="d1">person</data>
      <data key="d2">Company employees are personnel working for the Interstellar Peace Corporation, currently banned from entering the Dreamscape.</data>
      <data key="d3">chunk-0cfbc268760ea4bc489027077a7b65a7</data>
      <data key="d4">unknown_source</data>
