      <data key="d6" />
    </node>
    <node id="齿轮">
      <data key="d0">齿轮</data>
      <data key="d1">artifact</data>
      <data key="d2">齿轮is a symbol on the monument representing knowledge and industrial power, restraining the frost.&lt;SEP&gt;齿轮is a gear symbol that represents the筑城者' spirit of resistance against nature.</data>
      <data key="d3">chunk-01cda72aeaa485978711f9b72507b293&lt;SEP&gt;chunk-6f6083a9f5af04acd1ef8a41e5bfdfda</data>
